cat > .gitignore <<'EOF'
# dependencies
node_modules/

# build outputs
dist/
build/

# OS files
.DS_Store
Thumbs.db

# IDE/editor
.vscode/
.idea/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env
.env
EOF

node_modules/
